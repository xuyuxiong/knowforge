# ===========================
# KnowForge - 环境变量配置示例
# ===========================
# 复制此文件为 .env.local 并填入真实值
# ⚠️ .env.local 已加入 .gitignore，不会被提交

# ---------------------------
# 应用配置
# ---------------------------
NODE_ENV=development
PORT=4000

# ---------------------------
# 数据库配置 (PostgreSQL)
# ---------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=knowforge

# ---------------------------
# JWT 认证配置
# ---------------------------
JWT_SECRET=your-super-secret-key-min-32-chars-long
JWT_EXPIRES_IN=7d

# ---------------------------
# 向量数据库配置
# ---------------------------
# Chroma (开发环境)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=knowforge

# Milvus (生产环境)
# VECTOR_DB_HOST=localhost
# VECTOR_DB_PORT=19530

# ---------------------------
# 大语言模型配置
# ---------------------------
# 支持 OpenAI 兼容接口的 LLM 服务
# 填入你的 API Key 和 Base URL
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen-max
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ---------------------------
# 嵌入模型配置
# ---------------------------
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=http://localhost:11434/v1

# ---------------------------
# RAG 配置
# ---------------------------
RAG_TOP_K=5
RAG_METHOD=hybrid
# vector | keyword | hybrid
RAG_RERANK=true
RAG_MAX_CONTEXT_LENGTH=4000

# ---------------------------
# 文本分块配置
# ---------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ---------------------------
# 语雀配置（可选）
# ---------------------------
# 如果使用语雀同步功能，填入你的语雀团队和知识库信息
YUQUE_BASE_URL=https://yuque.example.com/api/v2
YUQUE_TEAM_LOGIN=your_team_login
YUQUE_BOOK_SLUG=your_book_slug
YUQUE_TOKEN=your-yuque-token-here

# ---------------------------
# 文件存储配置
# ---------------------------
STORAGE_PROVIDER=local
# local | oss

# 本地存储
UPLOAD_PATH=./uploads
UPLOAD_BASE_URL=/uploads
MAX_FILE_SIZE=52428800
# 50MB

# 对象存储（生产环境）
OSS_ENABLED=false
OSS_BUCKET=your-bucket-name
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_CDN_URL=https://your-cdn-domain.com

# ---------------------------
# 日志配置
# ---------------------------
LOG_LEVEL=debug
# debug | info | warn | error