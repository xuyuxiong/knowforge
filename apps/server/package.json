    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/typeorm": "^10.0.2",
    "@node-rs/jieba": "^2.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "ali-oss": "^6.20.0",
    "axios": "^1.6.8",
    "bcrypt": "^6.0.0",
